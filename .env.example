# Node/Bun versions are pinned in .node-version and .bun-version.
NODE_ENV=development
APP_PORT=43127
SWAGGER_ENABLED=false

# Host-machine connection. Compose overrides only the host/port for the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=core
POSTGRES_PORT=5432

# Required: replace every placeholder before starting the app.
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:43127
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:43127

# Only used by integration tests; requires permission to create/drop test databases.
# Never point this at a production PostgreSQL server.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core_test
