{
  "name": "core",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS, Better Auth and Drizzle PostgreSQL template with Bun and Vite+",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "commitlint": "commitlint",
    "prepare": "husky",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --fix",
    "lint:check": "vp lint --deny-warnings",
    "check": "vp check",
    "test": "vp test --project unit",
    "test:watch": "vp test watch --project unit",
    "test:e2e": "vp test --project e2e",
    "test:cov": "vp test run --project unit --coverage",
    "verify": "bun run check && bun run test:cov && bun run build && bun run test:e2e",
    "drizzle:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema": "auth generate --config ./auth.config.ts --output ./src/database/schema/auth.ts --yes",
    "staged": "vp staged"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.9",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "auth": "1.7.9",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  },
  "engines": {
    "bun": ">=1.4.3 <2",
    "node": ">=24.22.0 <25"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@nestjs/core",
    "@swc/core",
    "esbuild"
  ]
}
